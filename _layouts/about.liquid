---
layout: default
---
<div class="home-shell">
  <section class="research-hero" aria-labelledby="hero-title">
    <div class="research-hero__copy" data-reveal>
      <p class="eyebrow">{{ page.hero_kicker }}</p>
      <h1 id="hero-title">{{ page.hero_title }}</h1>
      <p class="research-hero__intro">{{ page.hero_intro }}</p>

      <div class="hero-actions">
        <a class="button button--primary" href="{{ '/publications/' | relative_url }}">
          View publications
          <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
        </a>
        <a class="button button--secondary" href="{{ '/cv/' | relative_url }}">Academic CV</a>
      </div>

      <div class="affiliation-history">
        <div class="affiliation-row" aria-label="Current affiliations">
          <span>Currently at</span>
          <a href="https://n3as.berkeley.edu/p/fellow/ian-padilla-gay/">UC Berkeley</a>
          <span aria-hidden="true">·</span>
          <a href="https://ucsd.edu">UC San Diego</a>
        </div>
        <div class="affiliation-row affiliation-row--previous" aria-label="Previous affiliations">
          <span>Before</span>
          <a href="https://www.stanford.edu">Stanford University</a>
          <span aria-hidden="true">·</span>
          <a href="https://theory.slac.stanford.edu/person/ian-padilla-gay">SLAC National Accelerator Laboratory</a>
        </div>
        <div class="education-history" aria-label="Education">
          <span class="education-history__item">
            <strong>PhD</strong>
            <a href="https://nbia.nbi.ku.dk/members/ian-padilla-gay/">University of Copenhagen</a>
            <abbr title="Denmark">[DK]</abbr>
          </span>
        </div>
      </div>
    </div>

    <div class="research-hero__visual" data-reveal data-delay="100">
      <div class="portrait-frame">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="portrait-image"
          sizes="(min-width: 992px) 380px, 82vw"
          alt=page.profile.image_alt
          cache_bust=true
        %}
      </div>
      <div class="portrait-caption">
        <span>N3AS Postdoctoral Fellow</span>
        <span>Theoretical Astrophysics</span>
      </div>
    </div>
  </section>

  <section class="home-section home-section--research" aria-labelledby="research-heading">
    <h2 id="research-heading" class="sr-only">Research overview</h2>
    {{ content }}
  </section>

  {% if site.data.citations.metrics %}
    {% assign scholar_metric = site.data.citations.metrics.google_scholar %}
    {% assign inspire_metric = site.data.citations.metrics.inspirehep %}
    <section class="citation-metrics" aria-labelledby="citation-metrics-heading" data-reveal>
      <div class="citation-metrics__intro">
        <p class="section-label">Research impact</p>
        <h2 id="citation-metrics-heading">Citation metrics</h2>
      </div>
      <div class="citation-metrics__content">
        <div class="citation-metrics__list">
          {% if scholar_metric %}
            <a class="citation-metric" href="{{ scholar_metric.url }}" aria-label="View Google Scholar profile">
              <span class="citation-metric__source">
                <i class="ai ai-google-scholar" aria-hidden="true"></i>
                Google Scholar
              </span>
              <strong>{{ scholar_metric.citations }}</strong>
              <span>Citations <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
            </a>
          {% endif %}

          {% if inspire_metric %}
            <a class="citation-metric" href="{{ inspire_metric.url }}" aria-label="View INSPIRE profile">
              <span class="citation-metric__source"><i class="ai ai-inspire" aria-hidden="true"></i> INSPIRE</span>
              <strong>{{ inspire_metric.citations }}</strong>
              <span>Citations <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
            </a>
          {% endif %}

          {% if inspire_metric.h_index %}
            <a class="citation-metric" href="{{ inspire_metric.url }}" aria-label="View INSPIRE h-index">
              <span class="citation-metric__source"><i class="ai ai-inspire" aria-hidden="true"></i> INSPIRE</span>
              <strong>{{ inspire_metric.h_index }}</strong>
              <span>h-index <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
            </a>
          {% endif %}

          {% if inspire_metric.articles %}
            <a class="citation-metric" href="{{ '/publications/' | relative_url }}" aria-label="View publications">
              <span class="citation-metric__source"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Research output</span>
              <strong>{{ inspire_metric.articles }}</strong>
              <span>Articles <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i></span>
            </a>
          {% endif %}
        </div>

        {% if inspire_metric.venues %}
          <div class="publication-venues" aria-label="Publication venues">
            <span>Venues</span>
            <ul>
              {% for venue in inspire_metric.venues %}
                <li>
                  {{ venue.name }}
                  <strong>{{ venue.count }}</strong>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if scholar_metric.citations_per_year %}
          {% assign first_citation_year = scholar_metric.citations_per_year | first %}
          {% assign last_citation_year = scholar_metric.citations_per_year | last %}
          <div class="impact-chart citation-history">
            <div class="impact-chart__heading">
              <span>Annual citations</span>
              <span>Google Scholar</span>
            </div>
            <div
              class="impact-chart__canvas-wrap"
              role="img"
              aria-label="Google Scholar citations received each year from {{ first_citation_year.year }} to {{ last_citation_year.year }}"
            >
              <canvas class="impact-chart__canvas citation-history__canvas" data-impact-chart="citations" aria-hidden="true"></canvas>
              <ol class="sr-only" data-chart-series="citations">
                {% for year in scholar_metric.citations_per_year %}
                  <li data-year="{{ year.year }}" data-value="{{ year.citations }}">{{ year.year }}: {{ year.citations }} citations</li>
                {% endfor %}
              </ol>
            </div>
          </div>
        {% endif %}

        {% if inspire_metric.arxiv_categories %}
          <div class="impact-chart arxiv-categories">
            <div class="impact-chart__heading">
              <span>Primary arXiv categories</span>
              <a href="{{ inspire_metric.arxiv_url }}">{{ inspire_metric.arxiv_submissions }} submissions</a>
            </div>
            <div
              class="impact-chart__canvas-wrap"
              role="img"
              aria-label="Primary arXiv category distribution across {{ inspire_metric.arxiv_submissions }} submissions"
            >
              <canvas class="impact-chart__canvas arxiv-categories__canvas" data-impact-chart="categories" aria-hidden="true"></canvas>
              <ul class="sr-only" data-chart-series="categories">
                {% for category in inspire_metric.arxiv_categories %}
                  <li data-category="{{ category.name }}" data-value="{{ category.count }}">{{ category.name }}: {{ category.count }} submissions</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}

        {% if site.data.citations.metadata.last_updated %}
          <p class="citation-metrics__updated">Updated {{ site.data.citations.metadata.last_updated | date: '%B %-d, %Y' }}</p>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section home-section--news" data-reveal>
      <div class="section-heading">
        <div>
          <p class="section-label">Updates</p>
          <h2>Recent news</h2>
        </div>
        <a href="{{ '/news/' | relative_url }}">View all</a>
      </div>
      {% include news.liquid limit=true %}
      <aside class="linkedin-update" aria-labelledby="linkedin-update-heading">
        <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
        <div>
          <p class="section-label">Latest on LinkedIn</p>
          <h3 id="linkedin-update-heading">Research notes and professional updates</h3>
          <p>Follow my latest work, talks, publications, and career updates on LinkedIn.</p>
        </div>
        <a
          class="button button--secondary"
          href="https://www.linkedin.com/in/ian-padilla-gay-2b0b0090/recent-activity/all/"
        >
          View latest post
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </aside>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section home-section--publications" data-reveal>
      <div class="section-heading">
        <div>
          <p class="section-label">Selected work</p>
          <h2>Featured publications</h2>
        </div>
        <a href="{{ '/publications/' | relative_url }}">Complete publication list</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.social %}
    <section class="contact-panel" data-reveal>
      <div>
        <p class="section-label">Contact</p>
        <h2>Interested in this work?</h2>
        <p>I welcome conversations and collaborations across neutrino physics, astrophysics, and nucleosynthesis.</p>
      </div>
      <div class="contact-panel__links">
        <a class="button button--primary" href="mailto:{{ site.data.socials.email }}">
          Send an email
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </a>
        <a class="button button--secondary" href="https://github.com/ianpaga">
          GitHub
          <i class="fa-brands fa-github" aria-hidden="true"></i>
        </a>
        <div class="contact-icons">{% social_links %}</div>
      </div>
    </section>
  {% endif %}
</div>
