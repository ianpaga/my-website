---
layout: default
---
<div class="home-shell">
  <section class="research-hero" aria-labelledby="hero-title">
    <div class="research-hero__copy" data-reveal>
      <p class="eyebrow">{{ page.hero_kicker }}</p>
      <h1 id="hero-title">{{ page.hero_title }}</h1>
      <p class="research-hero__intro">{{ page.hero_intro }}</p>

      <div class="hero-actions">
        <a class="button button--primary" href="{{ '/publications/' | relative_url }}">
          View publications
          <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
        </a>
        <a class="button button--secondary" href="{{ '/cv/' | relative_url }}">Academic CV</a>
      </div>

      <div class="affiliation-row" aria-label="Current affiliations">
        <span>Currently at</span>
        <a href="https://www.berkeley.edu">UC Berkeley</a>
        <span aria-hidden="true">·</span>
        <a href="https://ucsd.edu">UC San Diego</a>
      </div>
    </div>

    <div class="research-hero__visual" data-reveal data-delay="100">
      <div class="portrait-frame">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="portrait-image"
          sizes="(min-width: 992px) 380px, 82vw"
          alt=page.profile.image_alt
          cache_bust=true
        %}
      </div>
      <div class="portrait-caption">
        <span>N3AS Postdoctoral Fellow</span>
        <span>Theoretical Astrophysics</span>
      </div>
    </div>
  </section>

  {% if site.data.citations.metrics %}
    <section class="citation-metrics" aria-labelledby="citation-metrics-heading" data-reveal>
      <div class="citation-metrics__intro">
        <p class="section-label">Research impact</p>
        <h2 id="citation-metrics-heading">Citation metrics</h2>
      </div>
      <div class="citation-metrics__list">
        {% assign scholar_metric = site.data.citations.metrics.google_scholar %}
        {% if scholar_metric %}
          <a class="citation-metric" href="{{ scholar_metric.url }}" aria-label="View Google Scholar profile">
            <span class="citation-metric__source">
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
              Google Scholar
            </span>
            <strong>{{ scholar_metric.citations }}</strong>
            <span>Citations <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
          </a>
        {% endif %}

        {% assign inspire_metric = site.data.citations.metrics.inspirehep %}
        {% if inspire_metric %}
          <a class="citation-metric" href="{{ inspire_metric.url }}" aria-label="View INSPIRE profile">
            <span class="citation-metric__source"><i class="ai ai-inspire" aria-hidden="true"></i> INSPIRE</span>
            <strong>{{ inspire_metric.citations }}</strong>
            <span>Citations <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
          </a>
        {% endif %}
      </div>
      {% if site.data.citations.metadata.last_updated %}
        <p class="citation-metrics__updated">Updated {{ site.data.citations.metadata.last_updated | date: '%B %-d, %Y' }}</p>
      {% endif %}
    </section>
  {% endif %}

  <section class="home-section home-section--research" aria-labelledby="research-heading">
    <h2 id="research-heading" class="sr-only">Research overview</h2>
    {{ content }}
  </section>

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section home-section--news" data-reveal>
      <div class="section-heading">
        <div>
          <p class="section-label">Updates</p>
          <h2>Recent news</h2>
        </div>
        <a href="{{ '/news/' | relative_url }}">View all</a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section home-section--publications" data-reveal>
      <div class="section-heading">
        <div>
          <p class="section-label">Selected work</p>
          <h2>Featured publications</h2>
        </div>
        <a href="{{ '/publications/' | relative_url }}">Complete publication list</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.social %}
    <section class="contact-panel" data-reveal>
      <div>
        <p class="section-label">Contact</p>
        <h2>Interested in this work?</h2>
        <p>I welcome conversations and collaborations across neutrino physics, astrophysics, and nucleosynthesis.</p>
      </div>
      <div class="contact-panel__links">
        <a class="button button--primary" href="mailto:{{ site.data.socials.email }}">
          Send an email
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </a>
        <div class="contact-icons">{% social_links %}</div>
      </div>
    </section>
  {% endif %}
</div>
